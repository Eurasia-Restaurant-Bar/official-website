# Neon Postgres connection string (get from console.neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend API key (get from resend.com) — used to email reservation notifications
RESEND_API_KEY="re_xxxxxxxx"
# Email address that receives reservation notifications
RESTAURANT_NOTIFY_EMAIL="hello@eurasialisboa.pt"
# "From" address must be a verified domain in Resend, or use onboarding@resend.dev for testing
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Single shared password for the /admin area
ADMIN_PASSWORD="change-me"
# Random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET="change-me-too-a-long-random-string"

# Google Places API (New) key, restricted to Places API only — used to show live reviews
GOOGLE_PLACES_API_KEY="AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Google Place ID for the restaurant — resolved automatically via Places Text Search if left blank
GOOGLE_PLACE_ID=""
